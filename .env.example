# ——— FRAUD (required for signed tokens; falls back to a dev secret) ———
TOKEN_SIGNING_SECRET=

# ——— PHOTON (chat) — set both to go real ———
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_SPACE_ID=

# ——— DAYTONA (browser) ———
DAYTONA_API_KEY=
PUBLIC_BASE_URL=

# ——— NESSIE (bank) ———
NESSIE_API_KEY=
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
NESSIE_CUSTOMER_ID=
NESSIE_ACCOUNT_ID=

# ——— STRIPE (payments) ———
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# APP_BASE_URL is auto-detected from the wifi address at startup. Set it to override.
APP_BASE_URL=

# ——— misc (nico's payment demo) ———
ENABLE_PAYMENT_DEMO=false
DEMO_PAYMENT_ATTEMPT_ID=demo-chunk3-001
PAYMENT_STORE_PATH=
