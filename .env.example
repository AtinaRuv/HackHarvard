# iMessage is the entry point. The only web pages are private payment/live links.
APP_MODE=connected
APP_BASE_URL=http://127.0.0.1:6767
PORT=6767
HOST=127.0.0.1
DATA_DIR=data
# Optional: use an existing Chromium/Brave executable instead of playwright install.
# BROWSER_EXECUTABLE=/Applications/Brave Browser.app/Contents/MacOS/Brave Browser
BROWSER_PROVIDER=daytona
BOOKING_SOURCE=airbnb-reserve
PAYMENT_PROVIDER=demo
BANK_PROVIDER=nessie
# For a synthetic checkout, use BOOKING_SOURCE=demo and BANK_PROVIDER=demo.
DEMO_TOTAL_CENTS=96000

# Connected mode: real Photon transport + Stripe TEST + simulated Nessie banking.
# Use an HTTPS APP_BASE_URL reachable by participants. Stripe test mode is optional.
DAYTONA_API_KEY=

# Photon Spectrum iMessage (existing Stable project; dedicated line for groups).
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Photon Spectrum Voice: LightAuth-issued JWT, not an iMessage project secret.
PHOTON_VOICE_TOKEN=
PHOTON_VOICE_FROM=
# Voice synthesis uses local espeak and ffmpeg; no third-party TTS account.
ESPEAK_BINARY=espeak
FFMPEG_BINARY=ffmpeg
# Optional speech recognition service: POST audio/basic (8kHz PCMU), JSON {text}.
# Without this, calls speak the question and ask the organizer to reply by text.
VOICE_TRANSCRIBE_URL=
VOICE_TRANSCRIBE_TOKEN=

# Photon email (API/Beta project with a verified email domain and owned sender).
# These are separate credentials from the Spectrum iMessage project above.
PHOTON_EMAIL_API_KEY=
PHOTON_EMAIL_PROJECT_ID=
PHOTON_EMAIL_SENDER_ID=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NESSIE_API_KEY=
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
NESSIE_CUSTOMER_ID=
# Optional stable secret; otherwise a random persistent key is created in DATA_DIR.
TOKEN_SIGNING_SECRET=

# Optional SSH-accessible copies, each with this updated reset script installed.
# RESET_REMOTE_TARGETS=[{"host":"user@demo-server","project":"/home/user/HackHarvard"}]
RESET_REMOTE_TARGETS=[]
